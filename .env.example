# Node-to-Proxy 环境配置（复制为 .env 或直接注入环境变量）

# Web 控制台与 API 的访问令牌（强烈建议设置）。留空 = 不鉴权（仅建议本机使用）。
# HTTP/SOCKS5 代理出口支持两种认证：Bearer <令牌>，或 用户名=令牌/密码留空，
# 也支持任意已导入节点的 用户名/密码 组合。
API_TOKEN=

# 监听地址。默认 127.0.0.1；Docker 内请设为 0.0.0.0
BIND_HOST=127.0.0.1

# Web 控制台 / API 端口（独立于代理出口）
WEB_PORT=8080

# HTTP 代理出口端口
HTTP_PROXY_PORT=18999

# SOCKS5 代理出口端口
SOCKS5_PROXY_PORT=18998

# 健康检查周期（毫秒）
HEALTH_INTERVAL_MS=30000

# 健康检查超时（毫秒）
HEALTH_TIMEOUT_MS=3000

# 配置持久化目录（Docker 内对应 /data）
DATA_DIR=./data